{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayawe",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "ayawe.rimzzlabs.com", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ayawe",
      // Self-hosting? Run `pnpm exec wrangler d1 create ayawe` and put your own ID here.
      "database_id": "2dc1e912-b0a0-4977-89bb-450d8b8e8c69",
      "migrations_dir": "migrations"
    }
  ]
}
